# =========================
# utils.fun 站点配置
# =========================

# 站点标题
# 显示在网站头部、浏览器标题等位置
SITE_TITLE=My Utils

# 页面标题分隔符
# 例如页面标题可能显示为：JSON 格式化 | My Utils
SITE_TITLE_SEPARATOR=|

# 站点描述
# 用于首页介绍、SEO 描述等
SITE_DESCRIPTION=一个简洁实用的在线工具站

# 站点访问地址
# 填写你实际部署后使用的完整 URL
SITE_URL=https://tools.example.com

# Logo 图片地址
# 填写可直接访问的图片链接
SITE_LOGO_SRC=https://cdn.example.com/logo.png

# Logo 替代文本
# 图片无法加载时显示，也有利于可访问性
SITE_LOGO_ALT=My Utils Logo

# Logo 宽度
# 一般填写纯数字
SITE_LOGO_WIDTH=32

# Logo 高度
# 一般填写纯数字
SITE_LOGO_HEIGHT=32

# 是否隐藏 Logo
# true = 隐藏
# false = 显示
SITE_LOGO_HIDDEN=false

# 页脚 HTML
# 可放版权、备案号、友情链接、自定义说明等
# 如果内容里有空格或特殊符号，建议整体不要随意换行
SITE_FOOTER_HTML=<span>© 2026 My Utils</span>

# GitHub 仓库地址
# 页面通常会显示 GitHub 链接入口
SITE_GITHUB_URL=https://github.com/example/utils
